TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Keep BOT_PUBLIC_ACCESS=false during private testing.
TELEGRAM_ALLOWED_USER_IDS=
BOT_PUBLIC_ACCESS=false
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_BILLING_TIER=free
GEMINI_LIVE_VOICE=Aoede

# Add only providers for which you have API credentials.
# API keys are referenced by environment variable; do not paste real secrets here.
AI_PROVIDERS_JSON=[{"id":"openai","name":"OpenAI","base_url":"https://api.openai.com/v1","api_key":"${OPENAI_API_KEY}","models":["gpt-4.1-mini"]},{"id":"openrouter","name":"OpenRouter","base_url":"https://openrouter.ai/api/v1","api_key":"${OPENROUTER_API_KEY}","models":["openai/gpt-4.1-mini"]}]

# Optional; defaults to the first configured model key, e.g. openai:gpt-4.1-mini
DEFAULT_MODEL=

# AI HUB web app — set these only in your hosting provider's secret manager.
HUB_ACCESS_PASSWORD=
HUB_SESSION_SECRET=

# AI HUB PostgreSQL (Supabase Free for initial development)
# Keep real credentials only in your hosting provider's secret manager.
DATABASE_URL=
HUB_SIGNUP_CODE=
