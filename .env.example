TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Optional comma-separated Telegram numeric user IDs. Empty means public bot access.
TELEGRAM_ALLOWED_USER_IDS=
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Add only providers for which you have API credentials.
# API keys are referenced by environment variable; do not paste real secrets here.
AI_PROVIDERS_JSON=[{"id":"openai","name":"OpenAI","base_url":"https://api.openai.com/v1","api_key":"${OPENAI_API_KEY}","models":["gpt-4.1-mini"]},{"id":"openrouter","name":"OpenRouter","base_url":"https://openrouter.ai/api/v1","api_key":"${OPENROUTER_API_KEY}","models":["openai/gpt-4.1-mini"]}]

# Optional; defaults to the first configured model key, e.g. openai:gpt-4.1-mini
DEFAULT_MODEL=
